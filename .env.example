# ── GitHub (free, optional but recommended) ───────────────────────────────────
# Without token: 60 requests/hour. With token: 5000/hour.
# Get a free token at github.com/settings/tokens (no permissions needed)
GITHUB_TOKEN=your_github_personal_access_token

# ── Brave Search (free tier: 2000 queries/month) ──────────────────────────────
# Sign up at api.search.brave.com — no credit card needed
BRAVE_API_KEY=your_brave_search_api_key

# ── Gmail OAuth2 ───────────────────────────────────────────────────────────────
# 1. Create OAuth2 credentials at console.cloud.google.com (Desktop app type)
# 2. Enable the Gmail API
# 3. Run: node scripts/get-refresh-token.js to get your refresh token
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# ── Supabase ───────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your API key at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_CHAT_ID=your_telegram_user_id
